# Copie este archivo como .env y reemplace los valores. Nunca suba el archivo .env al repositorio.
NOMBRE_APLICACION="BitArcade API"
ENTORNO="desarrollo"
DEPURACION=true
PUERTO=8000
URL_BASE_DATOS="sqlite:///./dev.db"
CLAVE_SECRETA="reemplazar-por-un-valor-aleatorio-largo"
MINUTOS_EXPIRACION_TOKEN=30

# Parámetros financieros iniciales (TT-02). Porcentajes de 0 a 100.
TASA_IVA=19
MARGEN_GANANCIA=25
MONEDA_BASE="COP"

# Secreto HMAC compartido con la pasarela de pagos simulada (encabezado X-Signature).
SECRETO_PASARELA="reemplazar-por-secreto-de-la-pasarela"
# Token de servicio para las rutas /interno/v1 (encabezado X-Token-Servicio).
TOKEN_SERVICIO="reemplazar-por-token-de-servicio"

# Tareas programadas (expiración de reservas y órdenes, alertas de stock). 0 = desactivadas.
INTERVALO_TAREAS_SEGUNDOS=60
